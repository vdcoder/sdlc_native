# --------------------------------------------------------------------------
# LLM provider selection for get_llm() in main.py
# Every agent node (coder_agent, tester_agent, pr_review_agent) calls a real
# model through this one factory — swap providers with zero code changes.
# --------------------------------------------------------------------------

# "ollama" (default, local/offline, no API key) | "openai" | "gemini" | "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder

# Only required if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only required if LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# Only required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------
# External agent delegation (optional, per node)
# If set, that node's work is POSTed to the URL instead of calling an LLM
# locally — see send_requirements() in main.py for the wire protocol.
# --------------------------------------------------------------------------
EXTERNAL_AGENT_CODER=
EXTERNAL_AGENT_TESTER=
EXTERNAL_AGENT_PR_REVIEW=

